{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "agecalculator",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./dist",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none"
    },
    "routes": [
        {
            "pattern": "calc.hearteyesemoji.dev/*",
            "zone_name": "hearteyesemoji.dev"
        }
    ]
}
